    "test:content-push": "node --test tests/content-push-sql.test.mjs tests/course-push-dispatch.test.mjs",
    "test:club-signup": "node --test tests/club-signup-tunnel.test.mjs tests/club-signup-sql.test.mjs tests/club-signup-edge.test.mjs tests/domains.test.mjs"
