---
// Lien d'action : l'attribut data-event est relevé par scripts/analytics.ts.
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'a'> { event?: string | null }
const { event, ...rest } = Astro.props;
const external = typeof rest.href === 'string' && /^https?:/.test(rest.href);
---
<a {...rest} data-event={event || undefined} rel={external ? 'noopener' : undefined}><slot /></a>
