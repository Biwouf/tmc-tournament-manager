---
import { compare } from '../data/content';
---
<section id="positionnement" class="sec">
  <div class="container">
    <div class="stack">
      <span class="eyebrow">Ce qu’on vend, et ce qu’on ne vend pas</span>
      <h2 class="h2">Les autres gèrent votre club. Nous, on le met en scène.</h2>
    </div>
    <div class="duo">
      {compare.map(side => (
        <div class:list={['duo__side', { 'duo__side--us': side.us }]}>
          <span class="duo__label">{side.label}</span>
          <h3 class="h3">{side.title}</h3>
          <dl>{side.rows.map(row => <div><dt>{row.k}</dt><dd>{row.v}</dd></div>)}</dl>
        </div>
      ))}
    </div>
  </div>
</section>
