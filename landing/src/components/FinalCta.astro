---
import TenupForm from './TenupForm.astro';
---
<section id="cta" class="final">
  <div class="container final__inner">
    <h2>Offrez-leur le <span>court central.</span></h2>
    <p>Ils jouent en amateurs. Le reste peut devenir pro, dès ce soir.</p>
    <TenupForm placement="cta-final" label="Essayer avec mon club" class="final__form">
      <span class="ok">En ligne en 2 min</span>
    </TenupForm>
  </div>
</section>
