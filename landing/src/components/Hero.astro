---
import { Picture } from 'astro:assets';
import TrackedLink from './TrackedLink.astro';
import { playerUrl, signupForm, trialCta } from '../config';
import appCapture from '../assets/hero/app-cac-actus.png';
import appTabs from '../assets/hero/app-cac-onglets.png';
import clubLogo from '../assets/hero/logo-cac.png';

const cta = trialCta('Essayer avec mon club', 'hero');
const bar = trialCta('Créer mon site et mon app', 'barre-mobile');
// État initial du score de démo (repris par le script) : 3e set, juste après la notification de fin du 2e.
const players = [
  { name: 'C. Vidal', rank: '15/4', cells: [{ v: 1, dim: true }, { v: 6, dim: false }, { v: 4, dim: false }], pt: '40', serving: true },
  { name: 'A. Marchand', rank: '30', cells: [{ v: 6, dim: false }, { v: 4, dim: true }, { v: 2, dim: false }], pt: '15', serving: false },
];
---
<section id="top" class="hero">
  <div class="court-wrap" aria-hidden="true">
    <div class="court">
      <i class="h" style="top:12.5%"></i><i class="h" style="top:87.5%"></i>
      <i class="v" style="left:23.1%"></i><i class="v" style="left:76.9%"></i>
      <i class="h" style="top:50%;left:23.1%;right:23.1%"></i>
    </div>
  </div>

  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__kicker"><span>Ils jouent en</span> <span class="strike">amateurs.</span></p>
      <h1>Faites-les se sentir comme des <span class="accent">pros.</span></h1>
      <p class="hero__sub">Le site et l’app de votre club de tennis, à ses couleurs&nbsp;: actus, événements, rencontres Ten’Up, live et affiches.</p>

      {signupForm ? (
        <form class="tenup" action={signupForm} method="get" data-event="cta_tenup_submit" data-tenup-form>
          <input type="hidden" name="utm_source" value="landing" />
          <input type="hidden" name="utm_content" value="hero" />
          <label class="tenup__field">
            <span>Lien Ten’Up de votre club</span>
            <input name="tenup" type="text" inputmode="url" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="500" required placeholder="tenup.fft.fr/club/…" />
          </label>
          <button class="btn btn--accent tenup__btn" type="submit">Voir mon club →</button>
        </form>
      ) : (
        <div class="btn-row hero__fallback" data-tenup-form>
          <TrackedLink class="btn btn--accent" href={cta.href} event={cta.event}>{cta.label}</TrackedLink>
        </div>
      )}
      <div class="hero__under">
        <span class="ok">30 jours gratuits</span>
        <span class="ok">Sans carte bancaire</span>
        {signupForm && <span class="ok">En ligne en 2 min</span>}
        {signupForm && (
          <details class="hero__help">
            <summary>Où trouver ce lien ?</summary>
            <p>Sur tenup.fft.fr, cherchez votre club (Rechercher › Un club), ouvrez sa page, puis copiez l’adresse.</p>
          </details>
        )}
      </div>
      <a class="hero__player" href={playerUrl}>
        <span class="hero__player-ic" aria-hidden="true">🎾</span>
        <span>Vous êtes joueur ? <b>Retrouvez l’app de votre club →</b></span>
      </a>
    </div>

    <div class="hero-stage">
      <div class="hero-phone">
        <div class="hero-phone__screen">
          <div class="hero-phone__status" aria-hidden="true">
            <span>9:41</span>
            <span class="hero-phone__island"></span>
            <svg viewBox="0 0 66 13" fill="currentColor">
              <rect x="0" y="8" width="3" height="5" rx="1"/><rect x="5" y="5.5" width="3" height="7.5" rx="1"/><rect x="10" y="3" width="3" height="10" rx="1"/><rect x="15" y="0" width="3" height="13" rx="1"/>
              <path d="M30.5 12.6 28 9.9a3.6 3.6 0 0 1 5 0zM26.6 8.4l-1.5-1.6a7.7 7.7 0 0 1 10.8 0l-1.5 1.6a5.5 5.5 0 0 0-7.8 0zM23.7 5.4l-1.5-1.6a12 12 0 0 1 16.6 0l-1.5 1.6a9.8 9.8 0 0 0-13.6 0z"/>
              <rect x="42.5" y=".5" width="20" height="12" rx="3.5" fill="none" stroke="currentColor" opacity=".4"/><rect x="44" y="2" width="17" height="9" rx="2.2"/><rect x="64" y="4.5" width="1.6" height="4" rx=".8" opacity=".5"/>
            </svg>
          </div>
          <div class="hero-phone__content">
            <Picture src={appCapture} formats={['avif', 'webp']} widths={[260, 520, 780]} sizes="260px" loading="eager" decoding="async"
              alt="Capture de l’app du CAC Tennis Club : le fil des actualités du club" />
          </div>
          <div class="hero-phone__tabs" aria-hidden="true">
            <Picture src={appTabs} formats={['avif', 'webp']} widths={[260, 520, 780]} sizes="260px" loading="eager" decoding="async" alt="" />
          </div>
        </div>
      </div>
      <div class="hero-notif" aria-hidden="true">
        <img src={clubLogo.src} width="26" height="26" alt="" />
        <div><b>Fin du 2<sup>e</sup> set</b>Claire Vidal remporte le 2<sup>e</sup> set 6/4</div>
        <span class="hero-notif__at">10:58</span>
      </div>
      <div class="sb" data-scoreboard>
        <div class="sb__tag"><span class="live">Live</span><span class="ctx">Simple 1 · Court 2</span></div>
        <div class="sb__board">
          <div class="sb__row sb__head" aria-hidden="true">
            <span style="flex:1"></span>
            <span class="sb__cells" data-set-labels><span class="sb__cell">Set 1</span><span class="sb__cell">Set 2</span><span class="sb__cell">Set 3</span><span class="sb__pt">Pts</span></span>
          </div>
          {players.map((player, index) => (
            <button type="button" class="sb__row" data-player={index} data-serving={String(player.serving)} aria-label={`Marquer le point pour ${player.name}`}>
              <span class="sb__srv"><span></span></span>
              <span class="sb__player"><span class="sb__name">{player.name}</span><span class="sb__rank">{player.rank}</span></span>
              <span class="sb__cells">
                <span data-cells>{player.cells.map(cell => <span class:list={['sb__cell', { 'is-dim': cell.dim }]}>{cell.v}</span>)}</span>
                <span class="sb__pt" data-pt>{player.pt}</span>
              </span>
            </button>
          ))}
        </div>
      </div>
      <p class="hero-stage__cap">Capture réelle : app du CAC Tennis Club · score de démo</p>
    </div>
  </div>
</section>

<div class="mbar" data-mbar>
  <TrackedLink class="btn btn--accent" href={bar.href} event={bar.event}>{bar.label}</TrackedLink>
</div>

<script>
  // Score animé de la maquette : même règle de jeu (avantage, sets à 6 jeux, 7-5 ou 7-6).
  const root = document.querySelector<HTMLElement>('[data-scoreboard]');
  if (root) {
    const POINTS = ['0', '15', '30', '40', 'AD'];
    const INITIAL = { done: [[1, 6], [6, 4]], cur: [4, 2], pts: [3, 1], srv: 0 };
    let state = INITIAL;
    const rows = [...root.querySelectorAll<HTMLButtonElement>('[data-player]')];
    const labels = root.querySelector<HTMLElement>('[data-set-labels]')!;

    const point = (w: number) => {
      const l = 1 - w;
      const pts = [...state.pts];
      let game = false;
      if (pts[w] === 4 || (pts[w] === 3 && pts[l] < 3)) game = true;
      else if (pts[w] === 3 && pts[l] === 3) pts[w] = 4;
      else if (pts[l] === 4) pts[l] = 3;
      else pts[w]++;
      if (!game) { state = { ...state, pts }; return render(); }
      let cur = [...state.cur];
      cur[w]++;
      let done = state.done;
      if ((cur[w] >= 6 && cur[w] - cur[l] >= 2) || cur[w] === 7) {
        done = [...done, cur];
        if (done.filter(g => g[w] > g[1 - w]).length === 2) { state = INITIAL; return render(); }
        cur = [0, 0];
      }
      state = { done, cur, pts: [0, 0], srv: 1 - state.srv };
      render();
    };

    const cell = (value: number, dim: boolean) => `<span class="sb__cell${dim ? ' is-dim' : ''}">${value}</span>`;
    function render() {
      const sets = [...state.done, state.cur];
      labels.innerHTML = sets.map((_, i) => `<span class="sb__cell">Set ${i + 1}</span>`).join('') + '<span class="sb__pt">Pts</span>';
      rows.forEach((row, i) => {
        row.dataset.serving = String(state.srv === i);
        row.querySelector('[data-cells]')!.innerHTML =
          state.done.map(g => cell(g[i], g[i] < g[1 - i])).join('') + cell(state.cur[i], false);
        row.querySelector('[data-pt]')!.textContent = POINTS[state.pts[i]];
      });
    }

    rows.forEach((row, i) => row.addEventListener('click', () => point(i)));

    // Lecture automatique, sauf si l'utilisateur demande moins d'animations ou si le score est hors écran.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let timer: number | undefined;
      new IntersectionObserver(([entry]) => {
        clearInterval(timer);
        if (entry.isIntersecting) timer = window.setInterval(() => point(Math.random() < 0.52 ? 0 : 1), 2400);
      }).observe(root);
    }
  }

  // Barre fixe mobile : visible une fois le champ Ten'Up du hero sorti de l'écran.
  const mbar = document.querySelector<HTMLElement>('[data-mbar]');
  const form = document.querySelector('[data-tenup-form]');
  if (mbar && form) {
    new IntersectionObserver(([entry]) => {
      mbar.classList.toggle('is-on', !entry.isIntersecting && entry.boundingClientRect.top < 0);
    }).observe(form);
  }
</script>
