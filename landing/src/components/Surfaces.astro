---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { surfaces } from '../data/content';

// Captures réelles déposées dans src/assets/captures/<site|app|backoffice>.(png|jpg|webp).
// Tant qu'une capture manque, l'emplacement hachuré de la maquette reste affiché.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/captures/*.{png,jpg,jpeg,webp}', { eager: true });
const capture = (key: string) => Object.entries(files).find(([path]) => path.split('/').pop()?.split('.')[0] === key)?.[1].default;
---
<section id="surfaces" class="sec sec--paper">
  <div class="container">
    <div class="sec-head surfaces__head">
      <h2 class="h2" style="max-width:820px">Votre club, trois courts couverts.</h2>
      <p class="lead" style="max-width:380px">Le site pour ceux qui découvrent le club, l’app pour ceux qui le vivent, le back-office pour ceux qui le font tourner. Une seule saisie alimente les trois.</p>
    </div>
    <div class="surfaces__grid">
      {surfaces.map(surface => {
        const image = capture(surface.key);
        return (
          <article class="surface">
            <span class="surface__url">{surface.url}</span>
            <div class="surface__shot">
              {image
                ? <Picture src={image} formats={['avif', 'webp']} widths={[400, 800]} sizes="(max-width: 720px) 90vw, 400px" alt={`Capture d’écran : ${surface.title.toLowerCase()}`} loading="lazy" decoding="async" />
                : <span aria-hidden="true">{surface.cap}</span>}
            </div>
            <h3>{surface.title}</h3>
            <ul class="dash-list">{surface.items.map(item => <li>{item}</li>)}</ul>
          </article>
        );
      })}
    </div>
  </div>
</section>
