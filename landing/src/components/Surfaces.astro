---
import { Picture } from 'astro:assets';
import PhoneFrame from './PhoneFrame.astro';
import { surfaces } from '../data/content';
// Imports directs : une capture manquante fait échouer le build.
import site from '../assets/captures/site.png';
import app from '../assets/captures/app.png';
import appTabs from '../assets/captures/app-onglets.png';
import backoffice from '../assets/captures/backoffice.png';

const shots = { site, backoffice };
---
<section id="surfaces" class="sec sec--paper">
  <div class="container">
    <div class="sec-head">
      <div class="stack">
        <span class="eyebrow">Ce que reçoit votre club</span>
        <h2 class="h2">Trois écrans. Une seule saisie : celle de Ten’Up.</h2>
      </div>
      <p class="lead">Le site pour ceux qui découvrent le club, l’app pour ceux qui le vivent, le back-office pour ceux qui le font tourner.</p>
    </div>
    <div class="surfaces">
      {surfaces.map(surface => (
        <article class="surface">
          <div class="surface__shot">
            {surface.key === 'app'
              ? <PhoneFrame content={app} tabs={appTabs} alt="Capture de l’app du CAC Tennis Club : les rencontres par équipe" />
              : <div class="browser">
                  <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>{surface.url}</span></div>
                  <Picture src={shots[surface.key]} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(max-width: 900px) 90vw, 420px" alt={surface.alt} loading="lazy" decoding="async" />
                </div>}
          </div>
          <div>
            <h3 class="h3">{surface.title}</h3>
            <ul class="dash-list">{surface.items.map(item => <li>{item}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
    <p class="caption">Captures réelles du CAC Tennis Club (Castelsarrasin)</p>
  </div>
</section>
