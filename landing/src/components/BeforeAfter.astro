---
import { Picture } from 'astro:assets';
import poster from '../assets/affiche-resultat.png';
---
<section id="avant-apres" class="sec">
  <div class="container stack" style="gap:48px">
    <div class="sec-head">
      <div class="stack">
        <span class="eyebrow">La même rencontre, deux clubs</span>
        <h2 class="h2 ba__h2">Même victoire. Pas le même dimanche soir.</h2>
      </div>
      <div class="ba__intro">
        <p class="lead">Faites glisser. Les résultats arrivent tout seuls depuis TEN’UP : composition, scores, classements. L’affiche se génère aux couleurs du club. Personne ne ressaisit rien.</p>
        <span class="ba__sync"><span class="pulse" aria-hidden="true"></span>Synchro TEN’UP automatique</span>
      </div>
    </div>

    <div class="ba" data-ba>
      <div class="ba__side ba__before">
        <div class="ba__post">
          <p class="muted">TC Saint-Aubin · dimanche, 19:07</p>
          <p class="title">Interclubs dames +35 - Equipe 1</p>
          <p>Victoire 3-1 a Montvallon ce dimanche !! Bravo les filles</p>
          <p>Claire 1/6 6/4 10/2, Sophie 6/3 6/4, Helene 4/6 3/6, double gagné 6/2 6/4</p>
          <p class="note">(résultats saisis par Patrick, merci de signaler les erreurs)</p>
          <div class="photo">photo à venir</div>
        </div>
        <span class="ba__label">Sans feelike.pro</span>
      </div>
      <div class="ba__side ba__after">
        <Picture
          src={poster}
          formats={['avif', 'webp']}
          widths={[480, 720, 1080]}
          sizes="(max-width: 720px) 94vw, 560px"
          alt="Affiche de résultat générée par feelike.pro : Interclubs Femmes +35, TC Saint-Aubin bat AS Montvallon 1 trois à un, avec le détail des simples et du double."
          loading="lazy"
          decoding="async"
        />
        <span class="ba__label">Avec feelike.pro</span>
      </div>
      <div class="ba__handle">
        <span class="ba__knob" role="slider" tabindex="0" aria-label="Comparer avant et après" aria-valuemin="0" aria-valuemax="100" aria-valuenow="30" aria-valuetext="30 % avant, 70 % après" data-ba-knob>‹ ›</span>
      </div>
    </div>
    <p class="ba__caption">Affiche de résultat réellement produite par le back-office, avec les données fictives de la rencontre de gauche.</p>
  </div>
</section>

<script>
  const slider = document.querySelector<HTMLElement>('[data-ba]');
  const knob = slider?.querySelector<HTMLElement>('[data-ba-knob]');
  if (slider && knob) {
    let dragging = false;
    const set = (value: number) => {
      const pos = Math.round(Math.max(2, Math.min(98, value)));
      slider.style.setProperty('--pos', `${pos}%`);
      knob.setAttribute('aria-valuenow', String(pos));
      knob.setAttribute('aria-valuetext', `${pos} % avant, ${100 - pos} % après`);
    };
    const fromPointer = (event: PointerEvent) => {
      const rect = slider.getBoundingClientRect();
      set(((event.clientX - rect.left) / rect.width) * 100);
    };
    slider.addEventListener('pointerdown', event => { dragging = true; slider.setPointerCapture(event.pointerId); fromPointer(event); });
    slider.addEventListener('pointermove', event => { if (dragging) fromPointer(event); });
    slider.addEventListener('pointerup', () => { dragging = false; });
    slider.addEventListener('pointercancel', () => { dragging = false; });
    knob.addEventListener('keydown', event => {
      const now = Number(knob.getAttribute('aria-valuenow'));
      const step = { ArrowLeft: -5, ArrowDown: -5, ArrowRight: 5, ArrowUp: 5, PageDown: -20, PageUp: 20 }[event.key];
      if (step) { event.preventDefault(); set(now + step); }
      if (event.key === 'Home') { event.preventDefault(); set(2); }
      if (event.key === 'End') { event.preventDefault(); set(98); }
    });
  }
</script>
