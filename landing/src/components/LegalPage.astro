---
import Base from '../layouts/Base.astro';
import { contactEmail } from '../config';

interface Props { title: string }
const { title } = Astro.props;
---
<!-- Contenu juridique à fournir : la page reste hors index et hors sitemap d'ici là. -->
<Base title={`${title} — feelike.pro`} description={`${title} de feelike.pro.`} noindex>
  <section class="page">
    <div class="page__inner">
      <span class="eyebrow">feelike.pro</span>
      <h1>{title}</h1>
      <p>Cette page est en cours de rédaction.{contactEmail && <> Pour toute question, écrivez à <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</>}</p>
    </div>
  </section>
</Base>
