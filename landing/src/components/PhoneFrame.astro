---
// Téléphone aux cotes d'un iPhone (points), autour d'une vraie capture de la PWA coupée en deux :
// le contenu et la barre d'onglets. `--pt` (largeur / 390) fixe la taille.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
interface Props { content: ImageMetadata; tabs: ImageMetadata; alt: string; loading?: 'eager' | 'lazy'; class?: string }
const { content, tabs, alt, loading = 'lazy', class: className } = Astro.props;
const picture = { formats: ['avif', 'webp'] as ('avif' | 'webp')[], widths: [260, 520, 780], sizes: '260px', loading, decoding: 'async' as const };
---
<div class:list={['device', className]}>
  <div class="device__screen">
    <div class="device__status" aria-hidden="true">
      <span>9:41</span>
      <span class="device__island"></span>
      <svg viewBox="0 0 66 13" fill="currentColor">
        <rect x="0" y="8" width="3" height="5" rx="1"/><rect x="5" y="5.5" width="3" height="7.5" rx="1"/><rect x="10" y="3" width="3" height="10" rx="1"/><rect x="15" y="0" width="3" height="13" rx="1"/>
        <path d="M30.5 12.6 28 9.9a3.6 3.6 0 0 1 5 0zM26.6 8.4l-1.5-1.6a7.7 7.7 0 0 1 10.8 0l-1.5 1.6a5.5 5.5 0 0 0-7.8 0zM23.7 5.4l-1.5-1.6a12 12 0 0 1 16.6 0l-1.5 1.6a9.8 9.8 0 0 0-13.6 0z"/>
        <rect x="42.5" y=".5" width="20" height="12" rx="3.5" fill="none" stroke="currentColor" opacity=".4"/><rect x="44" y="2" width="17" height="9" rx="2.2"/><rect x="64" y="4.5" width="1.6" height="4" rx=".8" opacity=".5"/>
      </svg>
    </div>
    <div class="device__content"><Picture src={content} {...picture} alt={alt} /></div>
    <div class="device__tabs" aria-hidden="true"><Picture src={tabs} {...picture} alt="" /></div>
  </div>
</div>
