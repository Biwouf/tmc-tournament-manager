---
import { Picture } from 'astro:assets';
import poster from '../assets/affiche-resultat.png';
import { matchStory } from '../data/content';

const lineup = [['Simple 1', 'Claire Vidal', '15/4'], ['Simple 2', 'Sophie Lagarde', '30/1'], ['Simple 3', 'Hélène Faure', '30/2']];
---
<section id="un-match" class="sec">
  <div class="container">
    <div class="stack">
      <span class="eyebrow">Un dimanche d’interclubs</span>
      <h2 class="h2">Une photo le matin. Une affiche le soir.</h2>
      <p class="lead lead--wide">Entre les deux, le score se suit en direct et tout le club est prévenu.</p>
    </div>
    <ol class="day">
      {matchStory.map(card => (
        <li class="day__card">
          <div class="day__vis" aria-hidden={card.screen === 'poster' ? undefined : 'true'}>
            {card.screen === 'compo' && (
              <div class="mini">
                <p class="mini__bar">Prendre en photo la compo</p>
                {lineup.map(([slot, name, rank]) => <div class="mini__row"><span>{slot}</span><b>{name}</b> {rank}<em>✓ membre reconnu</em></div>)}
              </div>
            )}
            {card.screen === 'lock' && (
              <div class="day__notifs">
                <div class="note"><b>Match en direct</b>Claire Vidal - Anne Marchand - Le match commence !<span>09:15</span></div>
                <div class="note"><b>Fin du 1er set</b>Anne Marchand remporte le 1er set 6/1 contre Claire Vidal<span>10:02</span></div>
              </div>
            )}
            {card.screen === 'live' && (
              <div class="bug">
                <div class="bug__top"><span>Live</span>Simple 1 · court 2</div>
                <div class="bug__row"><b>C. Vidal</b><i class="is-dim">1</i><i>6</i><i>4</i><u>40</u></div>
                <div class="bug__row"><b>A. Marchand</b><i>6</i><i class="is-dim">4</i><i>2</i><u class="is-off">15</u></div>
              </div>
            )}
            {card.screen === 'poster' && (
              <Picture src={poster} formats={['avif', 'webp']} widths={[200, 400]} sizes="190px" class="day__poster" loading="lazy" decoding="async"
                alt="Affiche de résultat générée par feelike.pro : Interclubs Femmes +35, TC Saint-Aubin bat AS Montvallon 1 trois à un, avec le détail des simples et du double." />
            )}
          </div>
          <div class="day__txt">
            <span class="day__time">{card.time} · {card.who}</span>
            <h3 class="h3">{card.title}</h3>
            <p>{card.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="caption">Rencontre et joueuses fictives. Textes des notifications et affiche tels que le produit les génère.</p>
  </div>
</section>
