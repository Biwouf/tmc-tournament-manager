---
import '@fontsource/instrument-sans/latin-400';
import '@fontsource/instrument-sans/latin-500';
import '@fontsource/ibm-plex-mono/latin-400';
import '@fontsource/ibm-plex-mono/latin-500';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { analyticsDomain } from '../config';
import display700 from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-700-normal.woff2?url';
import display800 from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url';
import display900 from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-900-normal.woff2?url';
import bodyFont from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Pages sans contenu définitif (mentions légales…) : hors index et hors sitemap. */
  noindex?: boolean;
  jsonLd?: object[];
}

const { title, description, noindex = false, jsonLd = [] } = Astro.props;
// En sortie `build.format: 'file'`, le chemin vaut /index.html ou /cgv.html : URL propre (cleanUrls Vercel).
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
// Police des titres déclarée ici en `font-display: block` (préchargée) : avec `swap`, le
// remplacement d'une police de repli bien plus large décale le hero (CLS).
const displayFaces = [[700, display700], [800, display800], [900, display900]]
  .map(([weight, url]) => `@font-face{font-family:'Big Shoulders Display';font-style:normal;font-weight:${weight};font-display:block;src:url(${url}) format('woff2')}`)
  .join('');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#13120f" />
    <link rel="preload" href={display900} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={display700} as="font" type="font/woff2" crossorigin />
    <style set:html={displayFaces}></style>
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="feelike.pro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="feelike.pro — Faites-les se sentir comme des pros." />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map(data => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {analyticsDomain && (
      <>
        <script is:inline>window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };</script>
        <script is:inline defer data-domain={analyticsDomain} src="https://plausible.io/js/script.js"></script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
